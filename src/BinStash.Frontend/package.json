{
  "name": "binstash-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run codegen && vite",
    "build": "pnpm run codegen && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run codegen && vue-tsc --noEmit",
    "test": "pnpm run codegen && vitest run",
    "test:watch": "vitest",
    "test:ci": "pnpm run codegen && vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "schema": "dotnet run --project ../BinStash.Server -- --export-schema ../BinStash.Frontend/schema.graphql"
  },
  "dependencies": {
    "@apollo/client": "^4.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.45.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
