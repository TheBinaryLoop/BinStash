{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BinStashDb": "<from-keyvault>"
  },
  "Storage": {
    "AllowedRootPath": ""
  },
  "VersionGate": {
    "MinimumCliVersion": "1.0.0"
  },
  "RequestMetrics": {
    "Enabled": true,
    "SlowRequestThreshold": "00:00:05",
    "LogAllRequests": false,
    "ExpectedNonSuccessStatusCodes": [ 401, 403 ]
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 33554432,
    "MaxGrpcReceiveBytes": 16777216,
    "MaxSmallRequestBodyBytes": 65536
  },
  "RateLimiting": {
    "Enabled": true,
    "Authentication": { "PermitLimit": 10, "Window": "00:01:00" },
    "EmailDispatch": { "PermitLimit": 5, "Window": "00:15:00" },
    "IngestSessionCreation": { "PermitLimit": 60, "Window": "00:01:00" }
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": true,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true
  },
  "Billing": {
    "StorageStatsIntervalMinutes": 60,
    "EgressMeterCheckpointBytes": 67108864
  },
  "Traffic": {
    "Enabled": true,
    "FlushInterval": "00:01:00",
    "HourlyRetention": "30.00:00:00",
    "DailyRetention": "396.00:00:00",
    "MaintenanceInterval": "06:00:00"
  }
}
